<!--
  Compile the shared Supervertaler sources into a consuming project.

  Imported rather than referenced as an assembly: both consumers are CAT-tool
  plugins loaded into someone else's process, where every extra DLL is another
  thing to package correctly and another chance of an assembly-resolution
  conflict. The Trados plugin already lost a day to exactly that with SQLite.
  Compiling the source in costs a few seconds of build time and removes the
  entire class of problem.

  Usage, from a plugin's .csproj:

      <Import Project="..\..\core\Supervertaler.Core.props" />
-->
<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src\**\*.cs" />
  </ItemGroup>

  <!-- The shared code targets .NET Framework and uses HttpClient directly.
       System.IO.Compression: the .docx structure reader (DocxStructure.cs). -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <!-- GDI+, for rasterising the EMF/WMF drawings no vision model reads
         (ImageConversion.cs). A framework assembly, so nothing is deployed. -->
    <Reference Include="System.Drawing" />
    <!-- ProtectedData, for encrypting API keys at rest (DpapiSecret.cs, #115).
         Declared here rather than left to each consumer so a plugin picking up
         core does not fail to build on a reference it never knew it needed. -->
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
