<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for SuperVault's shared code (core/src/SuperVault and core/supervault), as a plain console program like
    core/tests. Everything happens in temporary folders; the Workbench database is only ever opened read-only, and
    only by the scale test (pass "real").

        dotnet build core/supervault/tests/SuperVault.Tests.csproj
        core/supervault/tests/bin/Debug/net48/SuperVault.Tests.exe [filter | real]

    Exit code 0 means every test passed.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SuperVault.Tests</AssemblyName>
    <RootNamespace>Supervertaler.Core.SuperVault.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\Supervertaler.Core.props" />
  <Import Project="..\Supervertaler.SuperVault.props" />

  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

</Project>
